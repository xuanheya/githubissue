{
  "manifest_version": 3,
  "name": "Issue 处理建议",
  "version": "1.0.0",
  "description": "在公开 GitHub Issue 页面生成有依据的处理建议，并根据补充背景更新。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
